{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bacaankunetwork",
  // Entrypoint kustom: fetch Astro + cron penjadwal artikel.
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "bacaankunetwork.com", "custom_domain": true },
    { "pattern": "www.bacaankunetwork.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bacaanku-db",
      "database_id": "a214341b-4997-4f9a-95d5-a129d484b99e"
    }
  ],
  // R2 sengaja belum diikat supaya situs bisa tayang tanpa verifikasi kartu.
  // Nanti tambahkan:
  // "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "bacaanku-media" }],
  // lalu secret/var: MEDIA_BASE = "https://media.bacaankunetwork.com"
  "triggers": { "crons": ["*/5 * * * *"] },
  // Secrets (jangan di file ini):
  //   npx wrangler secret put ADMIN_PASSWORD
  //   npx wrangler secret put ADMIN_TOKEN
  //   npx wrangler secret put CF_PURGE_TOKEN
  // Vars opsional saat Zero Trust / R2 siap:
  //   CF_ACCESS_TEAM_DOMAIN, CF_ACCESS_AUD, MEDIA_BASE
  // Zona produksi untuk purge cache (bukan secret).
  "vars": { "CF_ZONE_ID": "59edbd70449f300ca5f906d8649603ad" },
  "observability": { "enabled": false }
}
