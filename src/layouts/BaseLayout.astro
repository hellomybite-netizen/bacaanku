---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config/site';
import { formatPageTitle, truncateAtWord } from '../utils/seo';
import { IS_STATIC } from '../lib/mode';

/** GTM dan AdSense produksi. Pratinjau GitHub Pages (`BUILD_MODE=static`) tidak memuat tag ini. */
const analyticsSnippet = IS_STATIC
  ? ''
  : `<script async src="https://www.googletagmanager.com/gtm.js?id=GTM-T62FKJQ9"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
</script>
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1576914221961530"
     crossorigin="anonymous"></script>`;

interface Props {
  title: string;
  description: string;
  /** path relatif atau URL absolut; default = URL halaman ini */
  canonical?: string;
  image?: string; // URL absolut gambar OG
  imageAlt?: string;
  /** Dimensi gambar OG (px). Default = og-default.png 1200×630. */
  imageWidth?: number | null;
  imageHeight?: number | null;
  type?: 'website' | 'article';
  article?: { publishedTime: string; modifiedTime: string; section: string; tags: string[]; author: string };
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  /** Jangan cetak tag canonical / hreflang / og:url (mis. halaman 404/410) */
  noCanonical?: boolean;
  /** Judul utuh tanpa sufiks " | Bacaanku Network" (mis. beranda) */
  rawTitle?: boolean;
  currentCategory?: string;
}

const { title, description, canonical, image, imageAlt, imageWidth, imageHeight, type = 'website', article, jsonLd = [], noindex = false, noCanonical = false, rawTitle = false, currentCategory } = Astro.props;
const fullTitle = formatPageTitle(title, SITE.name, rawTitle);
const metaDescription = truncateAtWord(description, 155);
const canonicalUrl = noCanonical ? undefined : (canonical ? new URL(canonical, SITE.url).href : new URL(Astro.url.pathname, SITE.url).href);
const ogImage = image ?? new URL(SITE.defaultOgImage, SITE.url).href;
const ogWidth = image ? (imageWidth || undefined) : 1200;
const ogHeight = image ? (imageHeight || undefined) : 630;
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    {analyticsSnippet && <Fragment set:html={analyticsSnippet} />}
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href="/fonts/inter-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>try{document.querySelector('meta[name="color-scheme"]').content=localStorage.getItem("color-scheme")??"light dark"}catch(e){}</script>
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    {canonicalUrl && (
      <>
        <link rel="canonical" href={canonicalUrl} />
        <link rel="alternate" hreflang={SITE.hreflang} href={canonicalUrl} />
        <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
      </>
    )}
    {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#071827" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — semua berita`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- Open Graph -->
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={ogImage} />
    {ogWidth && ogHeight && (<><meta property="og:image:width" content={String(ogWidth)} /><meta property="og:image:height" content={String(ogHeight)} /></>)}
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {article && (
      <>
        <meta property="article:published_time" content={article.publishedTime} />
        <meta property="article:modified_time" content={article.modifiedTime} />
        <meta property="article:section" content={article.section} />
        <meta property="article:author" content={article.author} />
        {article.tags.map((t) => <meta property="article:tag" content={t} />)}
      </>
    )}
    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.twitter} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    {imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#konten">Langsung ke konten</a>
    <Header currentCategory={currentCategory} />
    <main id="konten" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
