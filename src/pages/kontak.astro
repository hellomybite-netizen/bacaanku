---
import PageLayout from '../layouts/PageLayout.astro';
import { SITE } from '../config/site';
---
<PageLayout title="Kontak" path="/kontak/" description="Hubungi redaksi bacaankunetwork.com untuk koreksi, hak jawab, kerja sama iklan, atau kiriman tulisan.">
  <p>Kami senang mendengar dari Anda. Pilih saluran yang sesuai:</p>
  <ul>
    <li>Redaksi, koreksi &amp; hak jawab: <a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
    <li>Iklan &amp; kerja sama: <a href="mailto:iklan@bacaankunetwork.com">iklan@bacaankunetwork.com</a></li>
  </ul>
  <p>Alamat redaksi: <em>(alamat contoh — isi sebelum live)</em></p>
  <p class="muted">Catatan: alamat email di atas adalah contoh dan belum aktif.</p>
</PageLayout>
