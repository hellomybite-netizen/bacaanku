---
import { categories } from '../../../config/site';

export const prerender = __BUILD_MODE__ === 'static';

export function getStaticPaths() {
  if (__BUILD_MODE__ !== 'static') return [];
  return categories.map((category) => ({ params: { category: category.slug, page: undefined } }));
}

const category = Astro.params.category ?? '';
if (!categories.some((item) => item.slug === category)) return new Response(null, { status: 404 });
return Astro.redirect(`/${category}/`, 301);
---
