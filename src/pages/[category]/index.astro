---
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Trending from '../../components/Trending.astro';
import GuideListing from '../../components/GuideListing.astro';
import { loadGuidesByCategory } from '../../lib/guide-repo';
import { guideCategory } from '../../lib/local-guide';
import { SITE, categories } from '../../config/site';
import { breadcrumbLd } from '../../utils/seo';
import { applyPublicCache } from '../../lib/cache-headers';
import { loadCategory } from '../../lib/public';

export const prerender = __BUILD_MODE__ === 'static';

export async function getStaticPaths() {
  if (__BUILD_MODE__ !== 'static') return [];
  const [{ categoryPaths }, { guideCategories }] = await Promise.all([
    import('../../lib/static-data'),
    import('../../lib/local-guide'),
  ]);
  return [...await categoryPaths(), ...guideCategories.map((category) => ({ params: { category: category.slug } }))];
}

const slug = Astro.params.category ?? '';
const guide = guideCategory(slug);
const before = Number(Astro.url.searchParams.get('before'));
const cursorId = Number(Astro.url.searchParams.get('id'));
const cursor = Number.isFinite(before) && before > 0 && Number.isFinite(cursorId) ? { publishedAt: before, id: cursorId } : null;
const page = guide ? null : await loadCategory(slug, cursor);
const guides = guide ? await loadGuidesByCategory(guide.slug) : [];
if (guide) applyPublicCache(Astro, 'list', [`cat-${guide.slug}`]);
const category = page?.category ?? guide;
if (!category) {
  Astro.response.status = 404;
  return new Response(null, { status: 404, statusText: 'Not Found' });
}
const { items = [], next, trending = [] } = page ?? {};
if (page) applyPublicCache(Astro, 'list', [`cat-${category.slug}`]);
const base = `/${category.slug}/`;
const crumbs = [{ name: 'Beranda', href: '/' }, { name: category.name, href: base }];
const title = cursor ? `Berita ${category.name} — sebelumnya` : category.slug === 'news' ? 'News — Berita Terkini Hari Ini' : `Berita ${category.name} Terkini`;
const categoryLead = items[0];
---
{guide ? (
  <GuideListing title={`${guide.name} Indonesia`} description={guide.description} image={guide.image} crumbs={crumbs}
    guides={guides} category={guide.slug} />
) : <BaseLayout title={title} description={`${category.description} Kumpulan berita ${category.name} terbaru di ${SITE.domain}.`} jsonLd={[breadcrumbLd(crumbs)]} currentCategory={category.slug}>
  <div class="container category-shell">
    <Breadcrumb items={crumbs} />
    <header class="category-hero">
      {categoryLead && (
        <div class="category-hero-media" aria-hidden="true">
          {categoryLead.heroImage ? (
            <Picture src={categoryLead.heroImage} alt="" formats={['avif', 'webp']} widths={[640, 960, 1440]} sizes="(min-width: 1240px) 1180px, calc(100vw - 2rem)" quality={70} loading="eager" fetchpriority="high" />
          ) : categoryLead.heroSrc && (
            <img src={categoryLead.heroSrc} srcset={categoryLead.heroSrcset} alt="" width={categoryLead.heroWidth ?? undefined} height={categoryLead.heroHeight ?? undefined} fetchpriority="high" />
          )}
        </div>
      )}
      <div class="category-hero-content">
        <p class="hero-kicker">Jelajahi Bacaanku</p>
        <h1 class="page-title">{category.name}</h1>
        <p>{category.description}</p>
      </div>
    </header>

    <nav class="category-tabs" aria-label="Kategori artikel">
      <a href="/" class="category-tab">Semua</a>
      {categories.map((item) => <a href={`/${item.slug}/`} class="category-tab" aria-current={item.slug === category.slug ? 'page' : undefined}>{item.name}</a>)}
    </nav>

    <div class="archive-heading">
      <div><p class="section-eyebrow">Koleksi terbaru</p><h2>{cursor ? `Artikel ${category.name} sebelumnya` : `Artikel ${category.name}`}</h2></div>
      <a class="rss-link" href={`/rss/${category.slug}.xml`}>RSS {category.name}</a>
    </div>
    <div class="with-sidebar">
      <div>
        {items.length === 0 ? <p>Belum ada berita di kategori ini.</p> : (
          <div class="grid archive-grid">{items.map((article) => <ArticleCard article={article} headingLevel={2} showDesc />)}</div>
        )}
        <nav class="pagination" aria-label="Halaman">
          {cursor ? <a href={base}>‹ Terbaru</a> : <span aria-disabled="true">‹ Terbaru</span>}
          {next ? <a href={`${base}?before=${next.publishedAt}&id=${next.id}`} rel="next">Berikutnya ›</a> : <span aria-disabled="true">Berikutnya ›</span>}
        </nav>
      </div>
      <div class="sidebar"><Trending items={trending} /><AdSlot size="rectangle" /></div>
    </div>
  </div>
</BaseLayout>}
