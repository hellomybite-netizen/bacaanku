---
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import Trending from '../../components/Trending.astro';
import { absUrl, articlePath, formatDateTime, isoDate } from '../../utils/articles';
import { breadcrumbLd, newsArticleLd } from '../../utils/seo';
import { applyPublicCache } from '../../lib/cache-headers';
import { loadArticle } from '../../lib/public';

export const prerender = __BUILD_MODE__ === 'static';

export async function getStaticPaths() {
  if (__BUILD_MODE__ !== 'static') return [];
  const { articlePaths } = await import('../../lib/static-data');
  return articlePaths();
}

const category = Astro.params.category ?? '';
const slug = Astro.params.slug ?? '';
const result = await loadArticle(category, slug);
if (result && 'redirect' in result) return Astro.redirect(result.redirect, 301);
if (!result) {
  Astro.response.status = 404;
}
const payload = result && !('redirect' in result) ? result : null;
const article = payload?.article;
const Content = payload?.Content;
if (article) {
  applyPublicCache(Astro, 'article', [
    `article-${article.id}`,
    `cat-${article.categorySlug}`,
    `author-${article.authorSlug}`,
    ...article.tags.map((tag) => `tag-${tag.slug}`),
  ]);
}
const path = article ? articlePath(article.categorySlug, article.slug) : Astro.url.pathname;
const pageUrl = absUrl(path);
const crumbs = article
  ? [
      { name: 'Beranda', href: '/' },
      { name: article.categoryName, href: `/${article.categorySlug}/` },
      { name: article.title, href: path },
    ]
  : [];
const authorUrl = article ? `/penulis/${article.authorSlug}/` : '';
const og = article?.heroSrc ? absUrl(article.heroSrc) : undefined;
const sizes = '(min-width: 1240px) 780px, (min-width: 960px) 64vw, calc(100vw - 2rem)';
---
{article ? (
  <BaseLayout
    title={article.seoTitle ?? article.title}
    description={article.excerpt}
    canonical={article.canonicalUrl ?? path}
    image={og}
    imageAlt={article.heroAlt}
    type="article"
    currentCategory={article.categorySlug}
    article={{
      publishedTime: isoDate(article.publishedAt),
      modifiedTime: isoDate(article.updatedAt),
      section: article.categoryName,
      tags: article.tags.map((tag) => tag.name),
      author: article.authorName,
    }}
    jsonLd={[
      newsArticleLd({
        url: pageUrl,
        headline: article.title,
        description: article.excerpt,
        image: og || absUrl('/og-default.png'),
        datePublished: new Date(article.publishedAt * 1000),
        dateModified: new Date(article.updatedAt * 1000),
        authorName: article.authorName,
        authorUrl: absUrl(authorUrl),
        section: article.categoryName,
        keywords: article.tags.map((tag) => tag.name),
      }),
      breadcrumbLd(crumbs),
    ]}
  >
    <div class="container">
      <Breadcrumb items={crumbs} />
      <div class="with-sidebar">
        <article class="article" data-pagefind-body>
          <header class="article-head">
            <a class="kicker" href={`/${article.categorySlug}/`}>{article.categoryName}</a>
            <h1 class="article-title">{article.title}</h1>
            <p class="article-dek">{article.excerpt}</p>
            <p class="article-meta">
              <span>Oleh <a href={authorUrl} rel="author">{article.authorName}</a></span>
              <span><time datetime={isoDate(article.publishedAt)}>{formatDateTime(article.publishedAt)}</time></span>
              {article.updatedAt - article.publishedAt > 60 && <span>Diperbarui <time datetime={isoDate(article.updatedAt)}>{formatDateTime(article.updatedAt)}</time></span>}
              <span>{article.readingMinutes} menit baca</span>
            </p>
            <ShareButtons url={pageUrl} title={article.title} />
          </header>
          {(article.heroImage || article.heroSrc) && (
            <figure class="article-hero">
              {article.heroImage ? (
                <Picture src={article.heroImage} alt={article.heroAlt} formats={['avif', 'webp']} widths={[480, 800, 1200, 1560]} sizes={sizes} quality={70} loading="eager" fetchpriority="high" decoding="sync" />
              ) : (
                <img src={article.heroSrc} srcset={article.heroSrcset} sizes={article.heroSrcset ? sizes : undefined} alt={article.heroAlt} width={article.heroWidth ?? undefined} height={article.heroHeight ?? undefined} fetchpriority="high" decoding="sync" />
              )}
              {(article.heroCaption || article.heroCredit) && (
                <figcaption>
                  {article.heroCaption}
                  {article.heroCredit && (
                    <span class="credit">
                      {article.heroCreditUrl ? <a href={article.heroCreditUrl} rel="noopener noreferrer" target="_blank">{article.heroCredit}<span class="visually-hidden"> (tab baru)</span></a> : article.heroCredit}
                    </span>
                  )}
                </figcaption>
              )}
            </figure>
          )}
          <div class="prose">
            {article.bodyHtml ? <Fragment set:html={article.bodyHtml} /> : Content && <Content />}
            {article.sources.length > 0 && (
              <div class="sources">
                <h2>Sumber</h2>
                <ul>
                  {article.sources.map((source) => (
                    <li>{source.name} — <a href={source.url} rel="noopener noreferrer" target="_blank">{source.title}<span class="visually-hidden"> (tab baru)</span></a></li>
                  ))}
                </ul>
              </div>
            )}
          </div>
          <AdSlot size="inarticle" />
          {article.tags.length > 0 && (
            <ul class="tags" aria-label="Tag">{article.tags.map((tag) => <li><a href={`/tag/${tag.slug}/`}>#{tag.name}</a></li>)}</ul>
          )}
          <aside class="author-box" aria-label="Tentang penulis">
            <p class="author-name"><a href={authorUrl}>{article.authorName}</a> <span class="muted small">· {article.authorRole}</span></p>
            <p class="muted small">{article.authorBio}</p>
          </aside>
        </article>
        <div class="sidebar"><Trending items={payload?.trending ?? []} /><AdSlot size="rectangle" /></div>
      </div>
      {payload && payload.related.length > 0 && (
        <section class="deferred related" aria-labelledby="terkait-title" data-pagefind-ignore>
          <h2 id="terkait-title" class="section-title">Artikel Terkait</h2>
          <div class="grid grid--4">{payload.related.map((item) => <ArticleCard article={item} />)}</div>
        </section>
      )}
    </div>
  </BaseLayout>
) : (
  <BaseLayout title="Halaman tidak ditemukan" description="Halaman yang Anda cari tidak ditemukan di bacaankunetwork.com." noindex>
    <div class="container narrow">
      <header class="page-head">
        <p class="kicker">Error 404</p>
        <h1 class="page-title">Halaman tidak ditemukan</h1>
        <p>Mungkin tautannya salah atau beritanya sudah dipindahkan. Coba <a href="/cari/">cari berita</a> atau kembali ke <a href="/">beranda</a>.</p>
      </header>
    </div>
  </BaseLayout>
)}
