---
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import Trending from '../../components/Trending.astro';
import ReviewBox from '../../components/ReviewBox.astro';
import RegionList from '../../components/RegionList.astro';
import { absUrl, articlePath, formatDateTime, isoDate } from '../../utils/articles';
import { breadcrumbLd, newsArticleLd } from '../../utils/seo';
import { reviewLd } from '../../lib/local';
import { isLocalCategory } from '../../config/site';
import { applyPublicCache } from '../../lib/cache-headers';
import { loadArticle } from '../../lib/public';
import { DELETED_SAMPLE_SLUGS } from '../../lib/gone';

export const prerender = __BUILD_MODE__ === 'static';

export async function getStaticPaths() {
  if (__BUILD_MODE__ !== 'static') return [];
  const { articlePaths } = await import('../../lib/static-data');
  return articlePaths();
}

const category = Astro.params.category ?? '';
const slug = Astro.params.slug ?? '';
const isGone = DELETED_SAMPLE_SLUGS.has(slug);
const result = isGone ? null : await loadArticle(category, slug);
if (result && 'redirect' in result) return Astro.redirect(result.redirect, 301);
if (isGone) {
  Astro.response.status = 410;
  Astro.response.headers.set('Cache-Control', 'public, max-age=3600, s-maxage=86400');
  Astro.response.headers.set('X-Robots-Tag', 'noindex');
} else if (!result) {
  Astro.response.status = 404;
}
const payload = result && !('redirect' in result) ? result : null;
const article = payload?.article;
const Content = payload?.Content;
if (article) {
  applyPublicCache(Astro, 'article', [
    `article-${article.id}`,
    `cat-${article.categorySlug}`,
    `author-${article.authorSlug}`,
    ...article.tags.map((tag) => `tag-${tag.slug}`),
  ]);
}
const path = article ? articlePath(article.categorySlug, article.slug) : Astro.url.pathname;
const pageUrl = absUrl(path);
const crumbs = article
  ? [
      { name: 'Beranda', href: '/' },
      { name: article.categoryName, href: `/${article.categorySlug}/` },
      { name: article.title, href: path },
    ]
  : [];
const authorUrl = article ? `/penulis/${article.authorSlug}/` : '';
const og = article?.heroSrc ? absUrl(article.heroSrc) : undefined;
const sizes = '(min-width: 1240px) 780px, (min-width: 960px) 64vw, calc(100vw - 2rem)';
const isLocal = article ? isLocalCategory(article.categorySlug) : false;
const reviewJson = article ? reviewLd(article, pageUrl) : null;
const placeHref = article?.daerahSlug ? (article.kotaSlug ? `/daerah/${article.daerahSlug}/${article.kotaSlug}/` : `/daerah/${article.daerahSlug}/`) : null;
if (article && isLocal) {
  crumbs.splice(1, 1,
    ...(article.daerahSlug ? [{ name: article.daerahName ?? article.daerahSlug, href: `/daerah/${article.daerahSlug}/` }] : []),
    ...(article.daerahSlug && article.kotaSlug && article.kota ? [{ name: article.kota, href: placeHref! }] : []),
    { name: article.categoryName, href: article.daerahSlug ? `${placeHref}${article.categorySlug}/` : `/${article.categorySlug}/` },
  );
}
---
{article ? (
  <BaseLayout
    title={article.seoTitle ?? article.title}
    description={article.excerpt}
    canonical={article.canonicalUrl ?? path}
    image={og}
    imageAlt={article.heroAlt}
    type="article"
    currentCategory={article.categorySlug}
    currentRegion={article.daerahSlug}
    noindex={article.isSample}
    article={{
      publishedTime: isoDate(article.publishedAt),
      modifiedTime: isoDate(article.updatedAt),
      section: article.categoryName,
      tags: article.tags.map((tag) => tag.name),
      author: article.authorName,
    }}
    jsonLd={[
      newsArticleLd({
        url: pageUrl,
        headline: article.title,
        description: article.excerpt,
        image: og || absUrl('/og-default.png'),
        datePublished: new Date(article.publishedAt * 1000),
        dateModified: new Date(article.updatedAt * 1000),
        authorName: article.authorName,
        authorUrl: absUrl(authorUrl),
        section: article.categoryName,
        keywords: article.tags.map((tag) => tag.name),
      }),
      breadcrumbLd(crumbs),
      ...(reviewJson ? [reviewJson] : []),
    ]}
  >
    <div class="container">
      <Breadcrumb items={crumbs} />
      <div class="with-sidebar">
        <article class="article" data-pagefind-body>
          <header class="article-head">
            <a class="kicker" href={`/${article.categorySlug}/`}>{article.categoryName}</a>
            <h1 class="article-title">{article.title}</h1>
            <p class="article-dek">{article.excerpt}</p>
            <p class="article-meta">
              <span>Oleh <a href={authorUrl} rel="author">{article.authorName}</a></span>
              <span><time datetime={isoDate(article.publishedAt)}>{formatDateTime(article.publishedAt)}</time></span>
              {article.updatedAt - article.publishedAt > 60 && <span>Diperbarui <time datetime={isoDate(article.updatedAt)}>{formatDateTime(article.updatedAt)}</time></span>}
              <span>{article.readingMinutes} menit baca</span>
            </p>
            {article.daerahSlug && (
              <p class="article-place">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11.2A7 7 0 0 1 19 9.8C19 14.8 12 21 12 21Z"/><circle cx="12" cy="10" r="2.5"/></svg>
                <a href={placeHref!}>{article.kota ? `${article.kota}, ` : ''}{article.daerahName}</a>
                <a class="article-place-sub" href={`${placeHref}${article.categorySlug}/`}>{article.categoryName} lain di {article.kota ?? article.daerahName} <span aria-hidden="true">→</span></a>
              </p>
            )}
            {article.isSample && (
              <p class="sample-banner" role="note"><strong>CONTOH.</strong> Halaman ini hanya placeholder untuk memperlihatkan tata letak. Tempat, harga, alamat, dan penilaian di sini bukan data nyata dan bukan ulasan.</p>
            )}
            <ShareButtons url={pageUrl} title={article.title} />
          </header>
          {(article.heroImage || article.heroSrc) && (
            <figure class="article-hero">
              {article.heroImage ? (
                <Picture src={article.heroImage} alt={article.heroAlt} formats={['avif', 'webp']} widths={[480, 800, 1200, 1560]} sizes={sizes} quality={70} loading="eager" fetchpriority="high" decoding="sync" />
              ) : (
                <img src={article.heroSrc} srcset={article.heroSrcset} sizes={article.heroSrcset ? sizes : undefined} alt={article.heroAlt} width={article.heroWidth ?? undefined} height={article.heroHeight ?? undefined} fetchpriority="high" decoding="sync" />
              )}
              {(article.heroCaption || article.heroCredit) && (
                <figcaption>
                  {article.heroCaption}
                  {article.heroCredit && (
                    <span class="credit">
                      {article.heroCreditUrl ? <a href={article.heroCreditUrl} rel="noopener noreferrer" target="_blank">{article.heroCredit}<span class="visually-hidden"> (tab baru)</span></a> : article.heroCredit}
                    </span>
                  )}
                </figcaption>
              )}
            </figure>
          )}
          {article.review && (
            <ReviewBox review={article.review} category={article.categorySlug} kota={article.kota} kotaSlug={article.kotaSlug} daerahName={article.daerahName} daerahSlug={article.daerahSlug} sample={article.isSample} />
          )}
          <div class="prose">
            {article.bodyHtml ? <Fragment set:html={article.bodyHtml} /> : Content && <Content />}
            {article.sources.length > 0 && (
              <div class="sources">
                <h2>Sumber</h2>
                <ul>
                  {article.sources.map((source) => (
                    <li>{source.name} — <a href={source.url} rel="noopener noreferrer" target="_blank">{source.title}<span class="visually-hidden"> (tab baru)</span></a></li>
                  ))}
                </ul>
              </div>
            )}
          </div>
          <AdSlot size="inarticle" />
          {article.tags.length > 0 && (
            <ul class="tags" aria-label="Tag">{article.tags.map((tag) => <li><a href={`/tag/${tag.slug}/`}>#{tag.name}</a></li>)}</ul>
          )}
          <aside class="author-box" aria-label="Tentang penulis">
            <p class="author-name"><a href={authorUrl}>{article.authorName}</a> <span class="muted small">· {article.authorRole}</span></p>
            <p class="muted small">{article.authorBio}</p>
          </aside>
        </article>
        <div class="sidebar">{article.daerahSlug ? <RegionList current={article.daerahSlug} hrefFor={(s) => `/daerah/${s}/${article.categorySlug}/`} title={`${article.categoryName} per daerah`} /> : <Trending items={payload?.trending ?? []} />}<AdSlot size="rectangle" /></div>
      </div>
      {payload && payload.related.length > 0 && (
        <section class="deferred related" aria-labelledby="terkait-title" data-pagefind-ignore>
          <h2 id="terkait-title" class="section-title">Artikel Terkait</h2>
          <div class="grid grid--4">{payload.related.map((item) => <ArticleCard article={item} />)}</div>
        </section>
      )}
    </div>
  </BaseLayout>
) : isGone ? (
  <BaseLayout title="Artikel telah dihapus" description="Artikel contoh ini telah dihapus permanen dari bacaankunetwork.com." noindex noCanonical>
    <div class="container narrow">
      <header class="page-head">
        <p class="kicker">Error 410</p>
        <h1 class="page-title">Artikel telah dihapus</h1>
        <p>Artikel contoh prototipe ini sudah dihapus permanen. Silakan kunjungi <a href="/">beranda</a> atau <a href="/cari/">cari berita</a> terbaru.</p>
      </header>
    </div>
  </BaseLayout>
) : (
  <BaseLayout title="Halaman tidak ditemukan" description="Halaman yang Anda cari tidak ditemukan di bacaankunetwork.com." noindex noCanonical>
    <div class="container narrow">
      <header class="page-head">
        <p class="kicker">Error 404</p>
        <h1 class="page-title">Halaman tidak ditemukan</h1>
        <p>Mungkin tautannya salah atau beritanya sudah dipindahkan. Coba <a href="/cari/">cari berita</a> atau kembali ke <a href="/">beranda</a>.</p>
      </header>
    </div>
  </BaseLayout>
)}
