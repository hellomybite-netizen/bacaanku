---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import GuideIcon from '../components/GuideIcon.astro';
import GuideCard from '../components/GuideCard.astro';
import { guideCategories, guideImage, guideRegions, regionPath } from '../lib/local-guide';
import { featuredGuides } from '../content/local-guides';
import { organizationLd, websiteLd } from '../utils/seo';
import { applyPublicCache } from '../lib/cache-headers';
import '../styles/local-wisdom.css';

applyPublicCache(Astro, 'home', ['home']);
---
<BaseLayout
  title="Bacaanku — Local Wisdom Indonesia"
  rawTitle
  description="Rekomendasi hotel, tempat wisata, dan kuliner khas dari berbagai daerah Indonesia."
  jsonLd={[organizationLd(), websiteLd('/jelajah/')]}
>
  <section class="guide-home-hero" aria-labelledby="home-title">
    <img class="guide-cover" src={guideImage('bromo')} srcset={`${guideImage('bromo', 'card')} 640w, ${guideImage('bromo')} 1600w`} sizes="100vw" alt="" width="1600" height="900" fetchpriority="high" />
    <div class="container guide-home-copy">
      <h1 id="home-title">Jelajahi Indonesia,<br />Temukan Cerita Baru.</h1>
      <p>Rekomendasi hotel, tempat wisata, dan kuliner terbaik di berbagai daerah Indonesia.</p>
      <form class="guide-search-form" action="/jelajah/" method="get" role="search">
        <GuideIcon name="search" />
        <label class="visually-hidden" for="home-search">Cari hotel, wisata, kuliner, atau kota</label>
        <input id="home-search" name="q" type="search" placeholder="Cari hotel, wisata, kuliner, atau kota..." maxlength="80" enterkeyhint="search" />
        <button type="submit"><span>Cari</span><GuideIcon name="search" /></button>
      </form>
    </div>
  </section>

  <div class="container">
    <nav class="guide-shortcuts" aria-label="Jelajahi kategori">
      {guideCategories.map((category) => (
        <a href={`/${category.slug}/`}>
          <span class:list={['guide-shortcut-icon', `guide-color-${category.slug}`]}><GuideIcon name={category.slug} /></span>
          <span><strong>{category.name}</strong><small>{category.short}</small></span>
        </a>
      ))}
    </nav>

    <section class="guide-home-section" aria-labelledby="pilihan-title">
      <div class="guide-section-head">
        <h2 id="pilihan-title">Ulasan Pilihan</h2>
        <a href="/jelajah/">Lihat Semua</a>
      </div>
      <div class="guide-grid guide-featured-grid">
        {featuredGuides.map((guide) => <GuideCard guide={guide} />)}
      </div>
    </section>

    <AdSlot size="leaderboard" />

    <section class="guide-home-section guide-home-regions" aria-labelledby="daerah-title">
      <div class="guide-section-head"><h2 id="daerah-title">Jelajahi Daerah</h2><a href="/daerah/">Lihat Semua Daerah</a></div>
      <div class="guide-grid">
        {guideRegions.slice(0, 3).map((region) => (
          <a class="guide-region-card" href={regionPath(region.slug)}>
            <img src={guideImage(region.image, 'card')} alt="" width="640" height="360" loading="lazy" />
            <span><strong>{region.name}</strong><small>{region.province}</small></span>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
