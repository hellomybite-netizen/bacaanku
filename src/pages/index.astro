---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import AdSlot from '../components/AdSlot.astro';
import Trending from '../components/Trending.astro';
import { SITE } from '../config/site';
import { organizationLd, websiteLd } from '../utils/seo';
import { applyPublicCache } from '../lib/cache-headers';
import { loadHome } from '../lib/public';

const { headline, secondary, latest, byCategory, trending } = await loadHome();
applyPublicCache(Astro, 'home', ['home']);
---
<BaseLayout
  title="bacaankunetwork.com — Berita Terkini Hari Ini yang Jernih dan Ringkas"
  rawTitle
  description={SITE.description}
  jsonLd={[organizationLd(), websiteLd()]}
>
  <h1 class="visually-hidden">bacaankunetwork.com — berita terkini hari ini</h1>
  <div class="container">
    <nav class="topic-strip" aria-label="Topik pilihan">
      <strong>Topik Pilihan</strong>
      <div>
        <a href="/news/">Kabar hari ini</a>
        <a href="/teknologi/">Dunia digital</a>
        <a href="/ekonomi/">Ekonomi rakyat</a>
        <a href="/sains/">Sains & lingkungan</a>
      </div>
    </nav>

    {headline ? (
      <>
        <div class="home-intro">
          <div>
            <p class="section-eyebrow">Pilihan redaksi</p>
            <h2>Kabar utama hari ini</h2>
          </div>
          <p>Ringkasan peristiwa penting, disusun agar cepat dipahami dan mudah ditelusuri.</p>
        </div>
        <section class="top-stories" aria-label="Berita utama">
          <div class="top-main"><ArticleCard article={headline} variant="hero" headingLevel={2} /></div>
          <ul class="top-side" role="list">
            {secondary.map((article, index) => (
              <li>
                <span class="story-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <ArticleCard article={article} variant="compact" />
              </li>
            ))}
          </ul>
        </section>
      </>
    ) : (
      <header class="page-head"><h2 class="page-title">Belum ada berita terbit</h2></header>
    )}

    <AdSlot size="leaderboard" />

    <div class="with-sidebar">
      <section aria-labelledby="terbaru-title">
        <div class="section-head latest-head">
          <div>
            <p class="section-eyebrow">Update pilihan redaksi</p>
            <h2 id="terbaru-title" class="section-title">Berita Terbaru</h2>
          </div>
          <a class="more-link" href="/news/">Semua berita <span aria-hidden="true">→</span></a>
        </div>
        <div class="latest-list">{latest.map((article) => <ArticleCard article={article} variant="list" showDesc />)}</div>
      </section>
      <div class="sidebar">
        <Trending items={trending} />
        <AdSlot size="rectangle" />
      </div>
    </div>

    {byCategory.map((category) => (
      <section class="cat-section deferred" aria-labelledby={`sec-${category.slug}`}>
        <div class="section-head">
          <div>
            <p class="section-eyebrow">Jelajahi topik</p>
            <h2 id={`sec-${category.slug}`} class="section-title">{category.name}</h2>
          </div>
          <a class="more-link" href={`/${category.slug}/`}>Lihat semua<span class="visually-hidden"> berita {category.name}</span> <span aria-hidden="true">→</span></a>
        </div>
        <div class="grid grid--4 category-grid">{category.items.map((article) => <ArticleCard article={article} />)}</div>
      </section>
    ))}
  </div>
</BaseLayout>
