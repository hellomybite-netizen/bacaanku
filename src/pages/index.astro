---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import AdSlot from '../components/AdSlot.astro';
import RegionTiles from '../components/RegionTiles.astro';
import { SITE, localCategories } from '../config/site';
import { organizationLd, websiteLd } from '../utils/seo';
import { applyPublicCache } from '../lib/cache-headers';
import { loadLocalHome } from '../lib/public';

const { latest, byCategory, regionCounts, archive } = await loadLocalHome();
applyPublicCache(Astro, 'home', ['home']);
const icons: Record<string, string> = {
  hotel: 'M3 20V8m0 6h18m0 6v-8a3 3 0 0 0-3-3h-7v6M7 11.5h.01',
  wisata: 'm3 19 6-10 4 6 2-3 6 7H3Zm13-12a2 2 0 1 0 0-.01',
  kuliner: 'M6 3v8a2 2 0 0 0 2 2v8M10 3v6M6 7h4M17 21V3c-2 1.5-3 4-3 7 0 2 1 3 3 3',
};
const blurb: Record<string, string> = {
  hotel: 'Penginapan & homestay',
  wisata: 'Alam, budaya, sejarah',
  kuliner: 'Warung & jajanan khas',
};
const feature = latest.find((a) => a.isHeadline) ?? latest[0] ?? null;
const glass = [...(feature ? [feature] : []), ...latest.filter((a) => a.id !== feature?.id)].slice(0, 4);
const shown = new Set(glass.map((a) => a.id));
const sections = byCategory.map((c) => ({ ...c, rest: c.items.filter((a) => !shown.has(a.id)) }));
const catCount = (slug: string) => byCategory.find((c) => c.slug === slug)?.items.length ?? 0;
---
<BaseLayout
  title="Bacaanku Network — Ulasan Hotel, Wisata & Kuliner Lokal Nusantara"
  rawTitle
  description={SITE.description}
  jsonLd={[organizationLd(), websiteLd()]}
>
  <section class="xp-hero" aria-labelledby="hero-title">
    <picture>
      <source media="(max-width: 672px)" srcset="/media/hero-nusantara-m-540.jpg 540w, /media/hero-nusantara-m-900.jpg 900w" sizes="100vw" />
      <img
        class="xp-hero-bg"
        src="/media/hero-nusantara-1920.jpg"
        srcset="/media/hero-nusantara-960.jpg 960w, /media/hero-nusantara-1920.jpg 1920w"
        sizes="100vw"
        width="1920"
        height="1000"
        alt=""
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <p class="xp-hero-credit">Ilustrasi contoh, bukan foto</p>
    <div class="container xp-hero-inner">
      <nav class="xp-rubrik" aria-label="Rubrik">
        <ul role="list">
          {localCategories.map((c) => (
            <li>
              <a href={`/${c.slug}/`}>
                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={icons[c.slug]} /></svg>
                {c.name}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <h1 id="hero-title">Jelajahi Nusantara lewat ulasan lokal</h1>
      <div class="xp-hero-search">
        <form action="/cari/" method="get" role="search" class="xp-search">
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <label class="visually-hidden" for="hero-q">Cari ulasan</label>
          <input id="hero-q" name="q" type="search" maxlength="80" placeholder="Cari warung, hotel, atau tempat wisata" enterkeyhint="search" />
          <button type="submit">Cari</button>
        </form>
        <a class="xp-btn-light" href="/daerah/">Lihat semua daerah <span aria-hidden="true">→</span></a>
      </div>
      {glass.length > 0 && (
        <div class="xp-glass-wrap">
          <h2 class="xp-glass-title">Ulasan pilihan</h2>
          <ul class="xp-glass lw-rail" role="list" aria-label="Ulasan pilihan, geser ke samping" tabindex="0">
            {glass.map((article, i) => <li><ArticleCard article={article} variant="glass" headingLevel={3} eager={i === 0} /></li>)}
          </ul>
        </div>
      )}
    </div>
  </section>

  <div class="container">
    <section class="lw-section" aria-labelledby="daerah-title">
      <div class="section-head">
        <div>
          <p class="section-eyebrow">Menu per daerah</p>
          <h2 id="daerah-title" class="section-title">Mau ke mana?</h2>
        </div>
        <a class="more-link" href="/daerah/">Semua daerah <span aria-hidden="true">→</span></a>
      </div>
      <RegionTiles counts={regionCounts} rail />
    </section>

    <AdSlot size="leaderboard" />

    {sections.map((category) => (
      <section class="lw-section lw-rubrik-section" aria-labelledby={`sec-${category.slug}`}>
        <div class="section-head">
          <div>
            <p class="section-eyebrow">Rubrik</p>
            <h2 id={`sec-${category.slug}`} class="section-title">{category.name}</h2>
            <p class="muted lw-section-desc">{category.description}</p>
          </div>
          <a class="more-link" href={`/${category.slug}/`}>Lihat semua<span class="visually-hidden"> ulasan {category.name}</span> <span aria-hidden="true">→</span></a>
        </div>
        {category.rest.length > 0
          ? <div class="lw-rail grid lw-grid-3" role="region" aria-label={`Ulasan ${category.name}, geser ke samping`} tabindex="0">{category.rest.map((article) => <ArticleCard article={article} showDesc />)}</div>
          : catCount(category.slug) > 0
            ? <p class="empty-note">Ulasan {category.name.toLowerCase()} terbaru sudah tampil di atas. <a href={`/${category.slug}/`}>Buka rubrik {category.name}</a>.</p>
            : <p class="empty-note">Ulasan {category.name.toLowerCase()} pertama sedang disiapkan.</p>}
      </section>
    ))}

    <section class="lw-promise" aria-labelledby="janji-title">
      <span class="lw-promise-motif" aria-hidden="true"></span>
      <p class="lw-promise-eyebrow">Janji redaksi</p>
      <h2 id="janji-title" class="section-title">Cara kami menulis</h2>
      <ul role="list">
        <li><strong>Ada alamat dan harga.</strong> Setiap ulasan punya kotak info: kisaran harga, alamat, jam buka, dan tautan peta.</li>
        <li><strong>Foto jelas sumbernya.</strong> Foto milik sendiri atau berlisensi terbuka, lengkap dengan kredit dan lisensinya.</li>
        <li><strong>Per daerah.</strong> Cari ulasan menurut provinsi dan kota, lalu saring menurut hotel, wisata, atau kuliner.</li>
      </ul>
    </section>

    {archive.length > 0 && (
      <section class="lw-section lw-archive" aria-labelledby="arsip-title">
        <div class="section-head">
          <div>
            <p class="section-eyebrow">Arsip</p>
            <h2 id="arsip-title" class="section-title">Dari Arsip Berita</h2>
          </div>
          <a class="more-link" href="/arsip-berita/">Buka arsip <span aria-hidden="true">→</span></a>
        </div>
        <ul class="lw-archive-list" role="list">
          {archive.map((article) => (
            <li><ArticleCard article={article} variant="compact" /></li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>
