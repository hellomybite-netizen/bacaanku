---
/** Segmen kedua: rubrik (/daerah/jawa-timur/kuliner/) ATAU kota (/daerah/jawa-timur/malang/). */
import RegionView from '../../../../components/RegionView.astro';
import { isLocalCategory } from '../../../../config/site';
import { applyPublicCache } from '../../../../lib/cache-headers';
import { loadRegion } from '../../../../lib/public';

export const prerender = __BUILD_MODE__ === 'static';

export async function getStaticPaths() {
  if (__BUILD_MODE__ !== 'static') return [];
  const { regionSubPaths } = await import('../../../../lib/static-data');
  return regionSubPaths();
}

const region = Astro.params.region ?? '';
const sub = Astro.params.sub ?? '';
const page = isLocalCategory(sub) ? await loadRegion(region, sub) : await loadRegion(region, null, sub);
if (!page) return new Response(null, { status: 404, statusText: 'Not Found' });
applyPublicCache(Astro, 'list', [`region-${page.region.slug}`, ...(page.category ? [`cat-${page.category.slug}`] : [])]);
---
<RegionView page={page} />
