---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { applyPublicCache } from '../lib/cache-headers';
import { loadSearch } from '../lib/public';
import { IS_STATIC } from '../lib/mode';

export const prerender = IS_STATIC;

const q = (Astro.url.searchParams.get('q') || '').trim().slice(0, 80);
const results = IS_STATIC ? [] : await loadSearch(q);
if (!IS_STATIC) applyPublicCache(Astro, 'search', ['search']);
---
<BaseLayout title="Cari Berita" description="Cari berita dan artikel di bacaankunetwork.com berdasarkan kata kunci." noindex>
  {IS_STATIC && <link slot="head" rel="stylesheet" href="/pagefind/pagefind-ui.css" />}
  <div class="container narrow">
    <header class="page-head"><h1 class="page-title">Cari berita</h1></header>
    {IS_STATIC ? (
      <div id="search" class="search-box">
        <noscript><p>Pencarian di pratinjau ini membutuhkan JavaScript. Silakan telusuri menu kategori.</p></noscript>
      </div>
    ) : (
      <>
        <form class="search-form" action="/cari/" method="get" role="search">
          <label class="visually-hidden" for="q">Kata kunci</label>
          <input id="q" name="q" type="search" value={q} maxlength="80" placeholder="Ketik kata kunci, mis. mobil listrik" enterkeyhint="search" />
          <button type="submit">Cari</button>
        </form>
        {q.length > 0 && q.length < 2 && <p>Ketik minimal 2 huruf.</p>}
        {q.length >= 2 && results.length === 0 && <p>Tidak ada hasil untuk “{q}”.</p>}
        {results.length > 0 && (
          <>
            <p class="muted small">{results.length} hasil untuk “{q}”.</p>
            <div class="grid">{results.map((article) => <ArticleCard article={article} headingLevel={2} showDesc />)}</div>
          </>
        )}
      </>
    )}
  </div>
  {IS_STATIC && (
    <>
      <script is:inline src="/pagefind/pagefind-ui.js"></script>
      <script is:inline>
        addEventListener('DOMContentLoaded', () => {
          const box = document.getElementById('search');
          if (!window.PagefindUI) { if (box) box.textContent = 'Indeks pencarian belum tersedia (jalankan npm run build:preview).'; return; }
          const ui = new PagefindUI({ element: '#search', showSubResults: false, showImages: false, resetStyles: false,
            translations: { placeholder: 'Ketik kata kunci, mis. mobil listrik', zero_results: 'Tidak ada hasil untuk [SEARCH_TERM]' } });
          const params = new URLSearchParams(location.search).get('q');
          if (params) ui.triggerSearch(params);
        });
      </script>
    </>
  )}
</BaseLayout>
