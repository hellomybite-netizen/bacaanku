---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
export const prerender = true;
const authors = (await getCollection('authors')).sort((a, b) => a.data.name.localeCompare(b.data.name, 'id'));
---
<PageLayout title="Redaksi" path="/redaksi/" description="Susunan redaksi bacaankunetwork.com: pemimpin redaksi, redaktur, dan reporter yang bertanggung jawab atas isi pemberitaan.">
  <p>Susunan redaksi bacaankunetwork.com. Profil yang masih bertanda contoh di halaman penulis perlu diganti sebelum tayang penuh. Penulis yang baru ditambahkan lewat ruang redaksi muncul di halaman masing-masing; halaman ini ikut build.</p>
  <dl class="redaksi">
    <dt>Pemimpin Redaksi</dt><dd>(nama contoh)</dd>
    <dt>Penanggung Jawab</dt><dd>(nama contoh)</dd>
    {authors.map((a) => (<><dt>{a.data.role}</dt><dd><a href={`/penulis/${a.data.slug}/`}>{a.data.name}</a></dd></>))}
  </dl>
</PageLayout>
