---
import { articlePath, formatDate } from '../utils/articles';
import type { ArticleCard } from '../lib/content-types';
interface Props { items: ArticleCard[] }
const { items } = Astro.props;
---
{items.length > 0 && (
  <section class="trending" aria-labelledby="trending-title">
    <p class="section-eyebrow">Banyak dibaca</p>
    <h2 id="trending-title" class="section-title">Terpopuler</h2>
    <ol class="trending-list">
      {items.map((article, index) => (
        <li>
          <span class="trend-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <a href={articlePath(article.categorySlug, article.slug)}>{article.title}</a>
            <p><span>{article.categoryName}</span><time datetime={new Date(article.publishedAt * 1000).toISOString()}>{formatDate(article.publishedAt)}</time></p>
          </div>
        </li>
      ))}
    </ol>
  </section>
)}
