---
import { SITE, categories } from '../config/site';
interface Props { currentCategory?: string }
const { currentCategory } = Astro.props;
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="masthead container">
    <a class="site-logo" href="/" aria-label={`${SITE.name} — beranda`}>
      <img class="logo-img logo-img--light" src="/brand/logo-light-h96.webp" srcset="/brand/logo-light-h48.webp 1x, /brand/logo-light-h96.webp 2x, /brand/logo-light-h144.webp 3x" width="340" height="96" alt="" decoding="async" />
      <img class="logo-img logo-img--dark" src="/brand/logo-dark-h96.webp" srcset="/brand/logo-dark-h48.webp 1x, /brand/logo-dark-h96.webp 2x, /brand/logo-dark-h144.webp 3x" width="340" height="96" alt="" decoding="async" />
    </a>
    <p class="brand-statement"><strong>Berita yang perlu kamu tahu.</strong><span>Jernih, ringkas, relevan.</span></p>
    <div class="header-actions">
      <a class="search-button" href="/cari/">
        <svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <span>Cari</span>
      </a>
      <button class="icon-btn theme-toggle" type="button">
        <span class="to-dark">
          <svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
          <span class="visually-hidden">Aktifkan mode gelap</span>
        </span>
        <span class="to-light">
          <svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <span class="visually-hidden">Aktifkan mode terang</span>
        </span>
      </button>
    </div>
  </div>

  <div class="nav-shell">
    <div class="header-inner container">
      <nav class="site-nav" aria-label="Kategori">
        <button class="menu-button" type="button" popovertarget="site-menu" popovertargetaction="toggle" aria-controls="site-menu">
          <svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
          <span>Jelajahi</span>
        </button>
        <ul id="site-menu" class="site-menu" popover="auto">
          <li><a href="/" aria-current={path === '/' ? 'page' : undefined}>Beranda</a></li>
          {categories.map((c) => (
            <li><a href={`/kategori/${c.slug}/`} aria-current={currentCategory === c.slug ? (path.startsWith(`/kategori/${c.slug}/`) ? 'page' : 'true') : undefined}>{c.name}</a></li>
          ))}
        </ul>
      </nav>
      <a class="latest-link" href="/#terbaru-title"><span aria-hidden="true"></span>Terbaru</a>
    </div>
  </div>
</header>

<script>
  // --- Navigasi responsif: inline bila muat, popover bila tidak (tanpa breakpoint tetap) ---
  const header = document.querySelector<HTMLElement>('.site-header')!;
  const inner = header.querySelector<HTMLElement>('.header-inner')!;
  const menu = document.getElementById('site-menu')!;
  let lastWidth = 0;
  function layout() {
    const width = inner.clientWidth;
    const wide = header.classList.contains('is-wide');
    if (!wide && width <= lastWidth) return; // saat collapsed, ukur ulang hanya jika melebar
    const wasOpen = menu.matches(':popover-open');
    header.classList.add('is-measuring', 'is-wide');
    menu.removeAttribute('popover');
    if (inner.scrollWidth > inner.clientWidth) {
      header.classList.remove('is-wide');
      menu.setAttribute('popover', 'auto');
      if (wasOpen) menu.showPopover();
    }
    lastWidth = width;
    requestAnimationFrame(() => header.classList.remove('is-measuring'));
  }
  const ro = new ResizeObserver(layout);
  ro.observe(header);
  ro.observe(menu);

  // --- Toggle mode gelap/terang (2 state: ikut sistem <-> kebalikan sistem) ---
  const meta = document.querySelector<HTMLMetaElement>('meta[name="color-scheme"]')!;
  const mq = matchMedia('(prefers-color-scheme: dark)');
  const store = (v: string | null) => {
    try { v ? localStorage.setItem('color-scheme', v) : localStorage.removeItem('color-scheme'); } catch {}
    meta.content = v ?? 'light dark';
  };
  document.querySelector('.theme-toggle')!.addEventListener('click', () => {
    const system = mq.matches ? 'dark' : 'light';
    const rendered = meta.content === 'light' || meta.content === 'dark' ? meta.content : system;
    const target = rendered === 'dark' ? 'light' : 'dark';
    store(target === system ? null : target);
  });
  addEventListener('storage', (e) => { if (e.key === 'color-scheme') meta.content = e.newValue ?? 'light dark'; });
</script>
