---
import { SITE, localCategories, regions } from '../config/site';
interface Props { currentCategory?: string; currentRegion?: string }
const { currentCategory, currentRegion } = Astro.props;
const path = Astro.url.pathname;
const inDaerah = path.startsWith('/daerah');
---
<header class="site-header">
  <div class="masthead container">
    <a class="site-logo" href="/" aria-label={`${SITE.name} — beranda`}>
      <img class="logo-img logo-img--light" src="/brand/logo-light-h96.webp" srcset="/brand/logo-light-h48.webp 1x, /brand/logo-light-h96.webp 2x, /brand/logo-light-h144.webp 3x" width="340" height="96" alt={SITE.name} decoding="async" />
      <img class="logo-img logo-img--dark" src="/brand/logo-dark-h96.webp" srcset="/brand/logo-dark-h48.webp 1x, /brand/logo-dark-h96.webp 2x, /brand/logo-dark-h144.webp 3x" width="340" height="96" alt={SITE.name} decoding="async" />
    </a>
    <nav class="lw-nav" aria-label="Menu utama">
      <ul class="lw-nav-list">
        {localCategories.map((c) => (
          <li><a href={`/${c.slug}/`} aria-current={currentCategory === c.slug ? 'page' : undefined}>{c.name}</a></li>
        ))}
        <li>
          <button class="lw-daerah-btn" type="button" popovertarget="daerah-menu" popovertargetaction="toggle" aria-controls="daerah-menu" data-active={inDaerah ? 'true' : undefined}>
            Daerah
            <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
        </li>
        <li class="lw-nav-arsip"><a href="/arsip-berita/">Arsip Berita</a></li>
      </ul>
    </nav>
    <div class="header-actions">
      <a class="search-button" href="/cari/">
        <svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <span>Cari</span>
      </a>
      <button class="icon-btn theme-toggle" type="button">
        <span class="to-dark">
          <svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
          <span class="visually-hidden">Aktifkan mode gelap</span>
        </span>
        <span class="to-light">
          <svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <span class="visually-hidden">Aktifkan mode terang</span>
        </span>
      </button>
    </div>
  </div>

  <div id="daerah-menu" class="daerah-panel" popover="auto" aria-label="Menu per daerah">
    <div class="container">
      <div class="daerah-panel-head">
        <p class="section-eyebrow">Menu per daerah</p>
        <a class="more-link" href="/daerah/">Semua daerah <span aria-hidden="true">→</span></a>
      </div>
      <ul class="daerah-grid" role="list">
        {regions.map((r) => (
          <li>
            <a href={`/daerah/${r.slug}/`} aria-current={currentRegion === r.slug ? 'page' : undefined}>
              <strong>{r.name}</strong>
              <span>{r.cities.slice(0, 3).join(' · ')}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="daerah-panel-foot"><a href="/arsip-berita/">Arsip Berita</a><span class="muted"> — berita lama, semua tautan tetap berfungsi</span></p>
    </div>
  </div>
</header>

<script>
  // --- Menu Daerah: posisikan panel tepat di bawah header (header sticky, tinggi bisa berubah) ---
  const header = document.querySelector<HTMLElement>('.site-header')!;
  const panel = document.getElementById('daerah-menu')!;
  panel.addEventListener('beforetoggle', () => {
    panel.style.setProperty('--panel-top', `${header.getBoundingClientRect().bottom}px`);
  });

  // --- Toggle mode gelap/terang (2 state: ikut sistem <-> kebalikan sistem) ---
  const meta = document.querySelector<HTMLMetaElement>('meta[name="color-scheme"]')!;
  const mq = matchMedia('(prefers-color-scheme: dark)');
  const store = (v: string | null) => {
    try { v ? localStorage.setItem('color-scheme', v) : localStorage.removeItem('color-scheme'); } catch {}
    meta.content = v ?? 'light dark';
  };
  document.querySelector('.theme-toggle')!.addEventListener('click', () => {
    const system = mq.matches ? 'dark' : 'light';
    const rendered = meta.content === 'light' || meta.content === 'dark' ? meta.content : system;
    const target = rendered === 'dark' ? 'light' : 'dark';
    store(target === system ? null : target);
  });
  addEventListener('storage', (e) => { if (e.key === 'color-scheme') meta.content = e.newValue ?? 'light dark'; });
</script>
