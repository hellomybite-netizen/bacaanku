---
import { SITE } from '../config/site';
import { cityPath, guideCategories, guideCities, guideProvinces, provincePath } from '../lib/local-guide';
interface Props { currentCategory?: string }
const { currentCategory } = Astro.props;
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="masthead container">
    <a class="site-logo" href="/" aria-label={`${SITE.name} — beranda`}>
      <img class="logo-img" src="/brand/logo-local-wisdom.svg" width="340" height="88" alt="Bacaanku — Local Wisdom Indonesia" decoding="async" />
    </a>
    <nav class="site-nav" aria-label="Navigasi utama">
      <ul id="site-menu" class="site-menu">
        {guideCategories.map((c) => (
          <li><a class={`nav-${c.slug}`} href={`/${c.slug}/`} aria-current={currentCategory === c.slug ? (path === `/${c.slug}/` ? 'page' : 'true') : undefined}>{c.name}</a></li>
        ))}
        <li class="nav-more">
          <details>
            <summary>Daerah</summary>
            <div class="nav-panel">
              <a href="/daerah/" aria-current={path === '/daerah/' ? 'page' : undefined}>Semua daerah</a>
              {guideProvinces.map((province) => <a href={provincePath(province.slug)} aria-current={path === provincePath(province.slug) ? 'page' : undefined}>{province.name}</a>)}
              {guideCities.filter((city) => city.nav).map((city) => <a href={cityPath(city.slug)} aria-current={path === cityPath(city.slug) ? 'page' : undefined}>{city.name}</a>)}
            </div>
          </details>
        </li>
        <li><a class="nav-artikel" href="/artikel/" aria-current={path === '/artikel/' ? 'page' : path.startsWith('/artikel/') ? 'true' : undefined}>Artikel</a></li>
      </ul>
    </nav>
    <div class="header-actions">
      <a class="search-button" href="/jelajah/" aria-label="Cari hotel, wisata, dan kuliner">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <span>Cari</span>
      </a>
      <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-menu" aria-label="Buka menu navigasi">
        <svg aria-hidden="true" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('.menu-button');
  const menu = document.getElementById('site-menu');
  button?.addEventListener('click', () => {
    const open = document.documentElement.classList.toggle('menu-open');
    button.setAttribute('aria-expanded', String(open));
  });
  menu?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) {
      document.documentElement.classList.remove('menu-open');
      button?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
