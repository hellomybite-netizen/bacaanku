---
import { guidePath, type Guide } from '../lib/local-guide';
import GuideIcon from './GuideIcon.astro';

interface Props { guide: Guide; headingLevel?: 2 | 3; showBudget?: boolean }
const { guide, headingLevel = 3, showBudget = false } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---
<article class="guide-card">
  <a class="guide-card-link" href={guidePath(guide)}>
    <img class="guide-card-image" src={guide.cardSrc || guide.heroSrc} alt={guide.imageAlt || guide.name} width="640" height="360" loading="lazy" decoding="async" />
    <div class="guide-card-copy">
      <span class:list={['guide-badge', `guide-color-${guide.category}`]}>{guide.categoryName}</span>
      <Heading>{guide.name}</Heading>
      <p class="guide-card-location"><GuideIcon name="pin" />{guide.location}</p>
      {showBudget && (guide.price?.value ? (
        <p class="guide-card-budget"><small>{guide.price.label}</small><strong>{guide.price.value}</strong></p>
      ) : guide.budget ? (
        <p class="guide-card-budget"><small>{guide.budget.label}</small><strong>{guide.budget.value}</strong></p>
      ) : (
        <p class="guide-card-budget"><span>{guide.category === 'hotel' ? 'Cek tarif & kamar' : guide.category === 'wisata' ? 'Cek tiket & kunjungan' : 'Lihat panduan kuliner'}</span></p>
      ))}
    </div>
  </a>
</article>
