---
interface Props { name: 'search' | 'pin' | 'hotel' | 'wisata' | 'kuliner' | 'clock' | 'calendar' }
const { name } = Astro.props;
---
<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'search' && <><circle cx="10.8" cy="10.8" r="6.3"/><path d="m16 16 4.3 4.3"/></>}
  {name === 'pin' && <><path d="M20 10c0 5.2-8 11-8 11s-8-5.8-8-11a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></>}
  {name === 'hotel' && <><path d="M3 19V5m18 14v-7a3 3 0 0 0-3-3h-7v7M3 16h18M6 12h5"/><circle cx="7.5" cy="8" r="1.5"/></>}
  {name === 'wisata' && <path d="m2 19 6.8-11 4 6.3L16.5 4 22 19H2Z" fill="currentColor" stroke-width="1"/>}
  {name === 'kuliner' && <><path d="M5 3v6c0 2 1.5 3 3 3s3-1 3-3V3M8 3v18M17 21v-8"/><ellipse cx="17" cy="8" rx="3" ry="5" fill="currentColor"/></>}
  {name === 'clock' && <><circle cx="12" cy="12" r="8"/><path d="M12 7.5v5l3 1.5"/></>}
  {name === 'calendar' && <><rect x="4.5" y="5.5" width="15" height="14" rx="2"/><path d="M8 4v3m8-3v3M5 10h14"/></>}
</svg>
