---
import { Picture } from 'astro:assets';
import { articlePath, formatDate } from '../utils/articles';
import type { ArticleCard as Card } from '../lib/content-types';

interface Props {
  article: Card;
  variant?: 'default' | 'compact' | 'hero' | 'list' | 'glass';
  headingLevel?: 2 | 3;
  showDesc?: boolean;
  /** Kartu pertama di atas lipatan (kandidat LCP): eager + fetchpriority=high. */
  eager?: boolean;
}
const { article, variant = 'default', headingLevel = 3, showDesc = false, eager = false } = Astro.props;
const H = `h${headingLevel}` as 'h2' | 'h3';
const isHero = variant === 'hero';
const priority = isHero || eager;
const sizes = isHero
  ? '(min-width: 1240px) 780px, (min-width: 960px) 64vw, calc(100vw - 2rem)'
  : variant === 'compact'
    ? '112px'
    : variant === 'list'
      ? '(min-width: 640px) 260px, 132px'
      : '(min-width: 1240px) 280px, (min-width: 640px) 45vw, calc(100vw - 2rem)';
const widths = isHero ? [480, 800, 1200, 1560] : variant === 'compact' ? [112, 224] : variant === 'list' ? [160, 320, 520] : [320, 480, 640];
const href = articlePath(article.categorySlug, article.slug);
---
<article class:list={['card', `card--${variant}`]}>
  <div class="card-media">
    {article.isSample && <span class="badge-contoh" title="Artikel contoh untuk tata letak, bukan ulasan nyata">CONTOH</span>}
    {article.daerahSlug && variant !== 'compact' && (
      <span class="card-pills">
        <span class="pill">{article.categoryName}</span>
        {article.rating != null && <span class="pill pill--rating"><span aria-hidden="true">★ </span>{article.rating.toFixed(1).replace('.', ',')}<span class="visually-hidden"> dari 5</span></span>}
      </span>
    )}
    {article.heroImage ? (
      <Picture
        src={article.heroImage}
        alt={article.heroAlt}
        formats={['avif', 'webp']}
        widths={widths}
        sizes={sizes}
        quality={isHero ? 70 : 60}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
        decoding={priority ? 'sync' : 'async'}
      />
    ) : article.heroSrc ? (
      <img
        src={article.heroSrc}
        srcset={article.heroSrcset}
        sizes={article.heroSrcset ? sizes : undefined}
        alt={article.heroAlt}
        width={article.heroWidth ?? undefined}
        height={article.heroHeight ?? undefined}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
        decoding={priority ? 'sync' : 'async'}
      />
    ) : (
      <div class="card-fallback" role="img" aria-label={article.heroAlt}></div>
    )}
  </div>
  <div class="card-body">
    {(!article.daerahSlug || variant === 'compact') && <a class="kicker" href={`/${article.categorySlug}/`}>{article.categoryName}</a>}
    <H class="card-title"><a href={href}>{article.title}</a></H>
    {(showDesc || isHero) && <p class="card-desc">{article.excerpt}</p>}
    {article.daerahSlug && (
      <p class="card-place">
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11.2A7 7 0 0 1 19 9.8C19 14.8 12 21 12 21Z"/><circle cx="12" cy="10" r="2.5"/></svg>
        <a href={article.kotaSlug ? `/daerah/${article.daerahSlug}/${article.kotaSlug}/` : `/daerah/${article.daerahSlug}/`}>{article.kota ? `${article.kota}, ` : ''}{article.daerahName}</a>
        {article.rating != null && variant === 'compact' && <span class="card-rating"><span aria-hidden="true">★ </span>{article.rating.toFixed(1).replace('.', ',')}<span class="visually-hidden"> dari 5</span></span>}
      </p>
    )}
    {article.priceRange && variant !== 'compact' && <p class="card-price">{article.priceRange}</p>}
    <p class="card-meta">{!article.daerahSlug && <span>{article.categoryName}</span>}<time datetime={new Date(article.publishedAt * 1000).toISOString()}>{formatDate(article.publishedAt)}</time></p>
  </div>
</article>
