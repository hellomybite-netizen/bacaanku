---
import { SITE, footerLinks } from '../config/site';
import { guideCategories } from '../lib/local-guide';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <p class="site-logo footer-logo"><img class="logo-img" src="/brand/logo-local-wisdom.svg" width="340" height="88" alt="Bacaanku — Local Wisdom Indonesia" decoding="async" loading="lazy" /></p>
      <p>Rekomendasi hotel, tempat wisata, dan kuliner dari berbagai daerah Indonesia.</p>
    </div>
    <nav aria-label="Kategori (footer)">
      <h2 class="footer-title">Kategori</h2>
      <ul class="footer-list">
        {guideCategories.map((c) => <li><a href={`/${c.slug}/`}>{c.name}</a></li>)}
        <li><a href="/daerah/">Daerah</a></li>
      </ul>
    </nav>
    <nav aria-label="Informasi">
      <h2 class="footer-title">Informasi</h2>
      <ul class="footer-list">{footerLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>
    <div>
      <h2 class="footer-title">Ikuti</h2>
      <ul class="footer-list">
        <li><a href="/rss.xml">RSS semua berita</a></li>
        <li><a href="/sitemap.xml">Sitemap</a></li>
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {year} {SITE.name} ({SITE.domain}). Hak cipta dilindungi.</span>
    <span>Local Wisdom Indonesia</span>
  </div>
</footer>
